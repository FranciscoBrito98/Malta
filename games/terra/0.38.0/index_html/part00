<div id="downed" class="hidden"></div>
<div id="reviveBar" class="hidden"><div></div></div>
<div id="combatHud" class="hidden">
  <div id="vitals"><div class="vr hp"><svg class="i"><use href="#ic-heart"/></svg><div class="bar"><div id="hpBar"></div></div><span id="hpTxt">100</span></div><div class="vr ar"><svg class="i"><use href="#ic-shield"/></svg><div class="bar"><div id="armorBar"></div></div><span id="arTxt"></span></div></div>
